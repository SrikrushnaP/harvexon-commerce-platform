# =============================================================================
# HCP Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# In production, ALL variables marked [REQUIRED] must be set.
# =============================================================================

# Server
PORT=3001
NODE_ENV=development

# Database [REQUIRED in production]
MONGODB_URI=mongodb://localhost:27017/hcp_dev

# JWT [REQUIRED in production]
# Generate secrets with: openssl rand -hex 32
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# File Upload
UPLOAD_DIR=uploads
# Max file size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880

# CORS
# Comma-separated list of allowed origins, or '*' for all (development only)
CORS_ORIGIN=http://localhost:4200,http://localhost:4300
